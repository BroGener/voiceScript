# Copy this file to .env and fill in your values
# .env is in .gitignore — never commit it to GitHub

# HuggingFace token (required for speaker diarization models)
# Get yours at: https://huggingface.co/settings/tokens
HF_TOKEN=hf_YOUR_TOKEN_HERE

# Default audio file path (optional — can be set in the web UI instead)
# AUDIO_PATH=D:\path\to\your\audio.mp3

# Data storage root (speakers DB, transcripts, processed audio)
DATA_ROOT=D:\whisper_data
